# ── Google Maps ────────────────────────────────
# 브라우저 키: 번들에 그대로 노출된다. HTTP 리퍼러 제한 필수.
# Vercel 환경별로 다른 값을 넣는다 (Production=도메인 한정 / Preview=*.vercel.app)
NEXT_PUBLIC_MAPS_KEY=

# 서버 키: Route Handler에서만 사용. 절대 NEXT_PUBLIC_ 접두사 금지.
MAPS_SERVER_KEY=

# ── Supabase ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS를 우회하므로 place_cache 쓰기 등 서버 코드에서만.
SUPABASE_SERVICE_ROLE_KEY=

# ── 원격 마이그레이션 (.env 에 넣는다, .env.local 아님) ─────────
# `pnpm db:deploy` 가 원격에 마이그레이션을 적용할 때만 쓴다. 앱은 읽지 않는다.
# 대시보드 → Settings → Database → Connection string 의 Session 모드 값.
#   SUPABASE_DB_URL=postgresql://postgres.<ref>:<비밀번호>@<host>:5432/postgres
#
# supabase db push 는 이 프로젝트에서 쓸 수 없다 — 기존 앱이 공유 이력 테이블을
# 소유하고 있어 거부된다. 자세한 내용은 scripts/db-deploy.mjs 주석 참고.

# ── 로컬 Supabase 스택용 (⚠️ 이 파일이 아니라 루트 .env 에 넣는다) ──
# supabase/config.toml 의 [auth.external.google] 이 env() 로 참조한다.
# Supabase CLI 는 프로젝트 루트의 .env 를 읽는다. supabase/.env 나 .env.local 에
# 넣으면 치환되지 않고 provider is not enabled 로 실패한다.
# 값은 Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID 에서 발급.
# 승인된 리디렉션 URI 는 앱 주소가 아니라 http://127.0.0.1:54321/auth/v1/callback 이다.
#
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
